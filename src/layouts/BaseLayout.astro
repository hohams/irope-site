---
import '../styles/global.css';
import IropeAnalytics from '../components/IropeAnalytics.astro';
import type { SiteConfig } from '../content/sites';
type Props = { site: SiteConfig; title?: string; description?: string; service?: { name: string; summary: string } };
const { site, title, description, service } = Astro.props as Props;
const pageTitle = title ? `${title} | ${site.name}` : (site.seo?.title || `${site.name} — ${site.tagline}`);
const pageDescription = description || site.seo?.description || site.hero.text;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = site.seo?.image ? new URL(site.seo.image, Astro.site) : undefined;
const provider = {
  '@type': 'ProfessionalService',
  '@id': new URL('/#irope', Astro.site).href,
  name: site.name,
  url: Astro.site?.href,
  telephone: site.phone,
  email: site.email,
  areaServed: { '@type': 'Country', name: 'Lithuania' },
};
const structuredData = site.id !== 'irope' ? undefined
  : service ? {
    '@context': 'https://schema.org', '@type': 'Service', name: service.name,
    description: service.summary, url: canonicalUrl.href, provider,
  }
  : Astro.url.pathname === '/' ? { '@context': 'https://schema.org', ...provider } : undefined;
---
<!doctype html>
<html lang={site.locale.split('-')[0]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#007f9e" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale.replace('-', '_')} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {ogImage && <meta property="og:image" content={ogImage.toString()} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/images/irope/logo-rope.png" type="image/png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{pageTitle}</title>
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
  </head>
  <body><slot />{site.id === 'irope' && <IropeAnalytics />}</body>
</html>
