---
import type { SiteConfig } from '../content/sites';
const { site } = Astro.props as { site: SiteConfig };
const endpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT;
const whatsapp = `https://wa.me/${site.phone.replace(/\D/g, '')}`;
const contactId = site.sectionIds.contact;
---
<section id={contactId} class="contact section" aria-labelledby="contact-title"><div><p class="eyebrow">Kontaktai</p><h2 id="contact-title">Papasakokite apie darbą</h2><p>Susisiekite jums patogiu būdu arba užpildykite formą. Atsakysime kuo greičiau.</p><address><a href={`mailto:${site.email}`}>{site.email}</a><br /><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a><br /><a href={whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Parašyti iRope per WhatsApp">WhatsApp</a></address></div><form action={endpoint || undefined} method={endpoint ? 'POST' : undefined} aria-describedby={!endpoint ? 'form-status' : undefined}><label for="name">Vardas *</label><input id="name" name="name" required autocomplete="name" /><label for="contact-details">Telefonas arba el. paštas *</label><input id="contact-details" name="contact" required autocomplete="email" /><label for="message">Trumpai apie darbą *</label><textarea id="message" name="message" required rows="5"></textarea>{endpoint && <input type="hidden" name="site" value={site.name} />}{endpoint ? <button class="button" type="submit">Siųsti užklausą</button> : <><button class="button" type="button" disabled aria-disabled="true">Forma dar neprijungta</button><p id="form-status" class="form-note" role="status">Šiuo metu forma dar nesiunčia užklausų. Parašykite el. paštu arba per WhatsApp.</p></>}</form></section>
