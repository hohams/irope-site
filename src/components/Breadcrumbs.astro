---
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
const trail = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map(({ name, path }, index) => ({
    '@type': 'ListItem', position: index + 1, name, item: new URL(path, Astro.site).href,
  })),
};
---
<nav class="crumbs" aria-label="Naršymo kelias">
  <ol>{items.map((item, index) => <li>
    {index === items.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.path}>{item.name}</a>}
  </li>)}</ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(trail).replace(/</g, '\\u003c')} />
<style>
  .crumbs ol { display: flex; align-items: baseline; flex-wrap: wrap; gap: .3rem .6rem; list-style: none; padding: 0; margin: 0 0 1.4rem; color: var(--muted); font-size: .9rem; }
  .crumbs li + li::before { content: '/'; padding-right: .6rem; color: #667d83; }
  .crumbs a { text-underline-offset: .16em; }
</style>
