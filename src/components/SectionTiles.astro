---
import { ropeAccess, serviceGroups } from '../content/irope-catalog';

const icons: Record<string, string> = {
  'latakai-ir-lietvamzdziai': 'M3 6h13v4a3 3 0 0 1-3 3H8a5 5 0 0 1-5-5Zm8 7v3a4 4 0 0 0 4 4h6 M15 13v2a1 1 0 0 0 1 1h5',
  'stogu-apsauga-ziema': 'M12 2v20 M3.35 7l17.3 10 M3.35 17l17.3-10 M9 4l3 3 3-3 M9 20l3-3 3 3 M4 10l4-1-1-4 M20 14l-4 1 1 4 M7 19l1-4-4-1 M17 5l-1 4 4 1',
  'stogu-prieziura': 'M2 13 12 4l10 9 M5 12v8h14v-8 M9 20v-5h6v5 M15 6V3h3v6',
  'fasadai-ir-stiklai': 'M4 3h16v18H4z M12 3v18 M4 12h16 M7 8l2-2 M15 17l2-2',
  'dumtraukiai-ir-pramones-objektai': 'M3 21h18 M4 21V11l5 3v-4l6 4 M15 21l1-16h3l1 16 M16 8h3 M7 17h1 M11 17h1',
  'montavimas-aukstyje': 'M3 21h7 M5 21V6l3-3v18 M3 7l5-4 12 4H3 M8 11l5-4 M18 7v6 M18 13v2a2 2 0 1 1-4 0',
};
---
<a class="rope-access" href={`/paslaugos/${ropeAccess.slug}/`} aria-labelledby="rope-access-heading">
  <span class="rope-symbol" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2v5m-5 18-1 5m6-3 2 3m-5-20 5-1 3 4c2 3 1 5-1 7l-5 5c-2 2-5 2-7 0s-2-5 0-7l5-8Z"/><path d="m12 15 5 5m-3-2 5-6"/></svg></span>
  <div><h3 id="rope-access-heading">{ropeAccess.name}</h3><p>{ropeAccess.summary}</p></div>
  <span class="rope-arrow" aria-hidden="true">→</span>
</a>
<ul class="tiles">
  {serviceGroups.map((group) => <li>
    <a class="tile" href={`/paslaugos/${group.slug}/`} aria-labelledby={`tile-${group.slug}`}>
      <span class="tile-top" aria-hidden="true">
        <span class="symbol"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round"><path d={icons[group.slug]} /></svg></span>
        <svg class="go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
      </span>
      <h3 id={`tile-${group.slug}`}>{group.name}</h3>
      <p>{group.summary}</p>
    </a>
  </li>)}
</ul>
<style>
  .rope-access { display: flex; align-items: center; gap: 1.1rem; margin-top: 1.5rem; padding: 1.3rem 1.4rem; border-radius: 1.25rem; color: #fff; background: #123c48; text-decoration: none; }
  .rope-access:is(:hover,:focus-visible) { background: #164f5d; }
  .rope-access h3 { margin: 0 0 .25rem; font-size: clamp(1.25rem,2.2vw,1.55rem); line-height: 1.15; }
  .rope-access:is(:hover,:focus-visible) h3 { text-decoration: underline; text-underline-offset: .16em; }
  .rope-access p { margin: 0; color: #e1eff1; font-size: .96rem; line-height: 1.45; }
  .rope-symbol { width: 2.8rem; height: 2.8rem; border-radius: .85rem; display: grid; place-items: center; flex: none; background: #275561; }
  .rope-symbol svg { width: 1.8rem; height: 1.8rem; }
  .rope-arrow { margin-left: auto; font-size: 1.45rem; }
  @media (max-width: 640px) {
    .rope-access { padding: 1rem; gap: .85rem; }
    .rope-access p { font-size: .88rem; }
  }

  .tiles { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); grid-auto-rows: 1fr; gap: 1rem; }
  .tiles li { display: flex; min-width: 0; }
  .tile { display: flex; flex: 1; flex-direction: column; padding: 1.3rem 1.4rem; min-width: 0; border: 1px solid #c7dcdf; border-radius: 1.25rem; text-decoration: none; color: var(--ink); background: white; }
  .tile-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.1rem; }
  .symbol { display: grid; place-items: center; width: 2.8rem; height: 2.8rem; border-radius: .85rem; background: #e1f2f2; color: #116471; }
  .symbol svg { width: 1.55rem; height: 1.55rem; }
  .go { width: 1.25rem; height: 1.25rem; color: #39727a; }
  .tile h3 { margin: 0 0 .4rem; font-size: clamp(1.13rem, 2vw, 1.32rem); line-height: 1.23; letter-spacing: -.025em; }
  .tile p { margin: 0; font-size: .94rem; line-height: 1.45; color: var(--muted); }
  .tile:is(:hover,:focus-visible) { border-color: #478589; background: #f3faf9; }
  .tile:is(:hover,:focus-visible) h3 { color: var(--accent-deep); text-decoration: underline; text-underline-offset: .16em; }
  @media (min-width: 641px) and (max-width: 900px) { .tiles { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 640px) {
    .tiles { grid-template-columns: 1fr; gap: .65rem; grid-auto-rows: auto; }
    .tile { display: grid; grid-template-columns: 2.7rem minmax(0,1fr) 1.1rem; grid-template-rows: auto auto; gap: .16rem .85rem; align-content: center; min-height: 6.4rem; padding: .95rem 1rem; }
    .tile-top { display: contents; }
    .symbol { grid-column: 1; grid-row: 1 / 3; align-self: center; }
    .go { grid-column: 3; grid-row: 1 / 3; align-self: center; width: 1.1rem; }
    .tile h3, .tile p { grid-column: 2; margin: 0; }
    .tile h3 { grid-row: 1; } .tile p { grid-row: 2; font-size: .88rem; }
  }
</style>
