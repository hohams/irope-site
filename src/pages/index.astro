---
import { activeSite } from '../content/sites';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ContactForm from '../components/ContactForm.astro';
import HeroCollage from '../components/HeroCollage.astro';
import Gallery from '../components/Gallery.astro';
const site = activeSite();
---
<BaseLayout {site}><Header {site} /><main><section class:list={["hero", { "hero-with-collage": site.id === "irope" }]} aria-labelledby="page-title"><div class="hero-copy"><p class="eyebrow">{site.hero.eyebrow}</p><h1 id="page-title">{site.hero.title}</h1><p class="lead">{site.hero.text}</p><a class="button" href={`#${site.sectionIds.contact}`}>{site.hero.primaryAction}</a></div>{site.id === "irope" && <HeroCollage />}</section><section id={site.sectionIds.services} class="section" aria-labelledby="services-title"><p class="eyebrow">Paslaugos</p><h2 id="services-title">Ką galime padaryti</h2><div class="cards">{site.services.map((service) => <article class="card"><h3>{service.title}</h3><p>{service.text}</p></article>)}</div></section>{site.id === 'irope' && <Gallery />}<section id={site.sectionIds.about} class="section split" aria-labelledby="about-title"><div><p class="eyebrow">Apie iRope</p><h2 id="about-title">Sprendimai ten, kur reikia dirbti aukštyje</h2></div><ul>{site.trust.map((item) => <li>{item}</li>)}</ul></section><ContactForm {site} /></main><footer>© {new Date().getFullYear()} {site.name} · {site.address} · <a href="/teisine-informacija/">Teisinė informacija</a></footer></BaseLayout>
