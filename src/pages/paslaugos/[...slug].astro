---
import WorkPage from '../../components/WorkPage.astro';
import metadata from '../../content/work-pages/metadata.json';
import { activeSite } from '../../content/sites';
export function getStaticPaths() {
  if (activeSite().id !== 'irope') return [];
  return (Object.keys(metadata) as (keyof typeof metadata)[])
    .filter(name => name !== 'home')
    .map(name => ({ params: {slug: name.split('_')[1]}, props: {name} }));
}
---
<WorkPage name={Astro.props.name} />
